# Copy to ".env" and adjust. Everything here is optional — the app runs with sane
# defaults and no secrets. (.env is gitignored.)

# --- server ---
# PORT=4000
# HTTPS_PORT=4443

# --- admin login ---
# If unset, a random password is generated and printed to the console on each boot.
# Set this to a fixed password once you deploy.
# ADMIN_PASSWORD=change-me

# --- database / images ---
# DB_PATH=./data/freshcart.db
# IMAGES_DIR=./data/images        # if empty/missing, the UI falls back to emoji

# --- SMS (phone-OTP login) ---
# Default 'console' = dev mode: no real SMS, the code is logged + returned by the API.
# SMS_PROVIDER=console
# SMS_PROVIDER=gateway
# SMS_URL=
# SMS_USER=
# SMS_KEY=
# SMS_SENDER=

# --- payment (checkout) ---
# Default 'none' = cash on delivery (no gateway).
# PAYMENT_PROVIDER=none
